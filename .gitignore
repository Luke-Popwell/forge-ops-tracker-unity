# This is a UPM package, not a full Unity project, so there is no Library/, Temp/, obj/, etc.
# generated by an Editor pointed directly at this folder: those only exist inside a *consuming*
# project's own root, never inside the package itself.

# .meta files ARE tracked deliberately (Unity's own convention: every asset needs a matching
# .meta file with a stable GUID, checked into source control, or references between assets break
# for every other machine that opens this package).

*.tmp
.DS_Store
